#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "robotiq_arg2f_140_model"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "robotiq_arg2f_140_model" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </robotiq_arg2f_140_model/Physics/root_joint>,
        </robotiq_arg2f_140_model/Physics/finger_joint>,
        </robotiq_arg2f_140_model/Physics/left_inner_knuckle_joint>,
        </robotiq_arg2f_140_model/Physics/right_outer_knuckle_joint>,
        </robotiq_arg2f_140_model/Physics/right_inner_knuckle_joint>,
        </robotiq_arg2f_140_model/Physics/left_outer_finger_joint>,
        </robotiq_arg2f_140_model/Physics/left_inner_finger_joint>,
        </robotiq_arg2f_140_model/Physics/left_inner_finger_pad_joint>,
        </robotiq_arg2f_140_model/Physics/right_outer_finger_joint>,
        </robotiq_arg2f_140_model/Physics/right_inner_finger_joint>,
        </robotiq_arg2f_140_model/Physics/right_inner_finger_pad_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </robotiq_arg2f_140_model/Geometry/robotiq_arg2f_base_link>,
        </robotiq_arg2f_140_model/Geometry/robotiq_arg2f_base_link/left_outer_knuckle>,
        </robotiq_arg2f_140_model/Geometry/robotiq_arg2f_base_link/left_outer_knuckle/left_outer_finger>,
        </robotiq_arg2f_140_model/Geometry/robotiq_arg2f_base_link/left_outer_knuckle/left_outer_finger/left_inner_finger>,
        </robotiq_arg2f_140_model/Geometry/robotiq_arg2f_base_link/left_outer_knuckle/left_outer_finger/left_inner_finger/left_inner_finger_pad>,
        </robotiq_arg2f_140_model/Geometry/robotiq_arg2f_base_link/left_inner_knuckle>,
        </robotiq_arg2f_140_model/Geometry/robotiq_arg2f_base_link/right_outer_knuckle>,
        </robotiq_arg2f_140_model/Geometry/robotiq_arg2f_base_link/right_outer_knuckle/right_outer_finger>,
        </robotiq_arg2f_140_model/Geometry/robotiq_arg2f_base_link/right_outer_knuckle/right_outer_finger/right_inner_finger>,
        </robotiq_arg2f_140_model/Geometry/robotiq_arg2f_base_link/right_outer_knuckle/right_outer_finger/right_inner_finger/right_inner_finger_pad>,
        </robotiq_arg2f_140_model/Geometry/robotiq_arg2f_base_link/right_inner_knuckle>,
    ]
    token isaac:robotType = "End Effector"

    over "Geometry"
    {
        over "robotiq_arg2f_base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "left_outer_knuckle" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "left_outer_finger" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "left_inner_finger" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "left_inner_finger_pad" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                        }
                    }
                }
            }

            over "left_inner_knuckle" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "right_outer_knuckle" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "right_outer_finger" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "right_inner_finger" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "right_inner_finger_pad" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                        }
                    }
                }
            }

            over "right_inner_knuckle" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }
        }
    }

    over "Physics"
    {
        over "root_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "finger_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "left_outer_finger_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "left_inner_knuckle_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "left_inner_finger_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "left_inner_finger_pad_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_outer_knuckle_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_outer_finger_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_inner_knuckle_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_inner_finger_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_inner_finger_pad_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

