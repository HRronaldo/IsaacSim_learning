#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "ur10"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "ur10"
{
    over "Physics"
    {
        over "shoulder_pan_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "shoulder_lift_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "elbow_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "wrist_1_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "wrist_2_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "wrist_3_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        def MjcActuator "shoulder_pan_joint_actuator"
        {
            uniform double mjc:forceRange:max = 330
            uniform double mjc:forceRange:min = -330
            custom rel mjc:target
            append rel mjc:target = </ur10/Physics/shoulder_pan_joint>
        }

        def MjcActuator "shoulder_lift_joint_actuator"
        {
            uniform double mjc:forceRange:max = 330
            uniform double mjc:forceRange:min = -330
            custom rel mjc:target
            append rel mjc:target = </ur10/Physics/shoulder_lift_joint>
        }

        def MjcActuator "elbow_joint_actuator"
        {
            uniform double mjc:forceRange:max = 150
            uniform double mjc:forceRange:min = -150
            custom rel mjc:target
            append rel mjc:target = </ur10/Physics/elbow_joint>
        }

        def MjcActuator "wrist_1_joint_actuator"
        {
            uniform double mjc:forceRange:max = 56
            uniform double mjc:forceRange:min = -56
            custom rel mjc:target
            append rel mjc:target = </ur10/Physics/wrist_1_joint>
        }

        def MjcActuator "wrist_2_joint_actuator"
        {
            uniform double mjc:forceRange:max = 56
            uniform double mjc:forceRange:min = -56
            custom rel mjc:target
            append rel mjc:target = </ur10/Physics/wrist_2_joint>
        }

        def MjcActuator "wrist_3_joint_actuator"
        {
            uniform double mjc:forceRange:max = 56
            uniform double mjc:forceRange:min = -56
            custom rel mjc:target
            append rel mjc:target = </ur10/Physics/wrist_3_joint>
        }
    }
}

