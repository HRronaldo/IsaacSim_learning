#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "robotiq_arg2f_140_model"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "robotiq_arg2f_140_model"
{
    over "Physics"
    {
        over "finger_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "left_inner_knuckle_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "left_inner_finger_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "right_outer_knuckle_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "right_inner_knuckle_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "right_inner_finger_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        def MjcActuator "finger_joint_actuator"
        {
            uniform double mjc:forceRange:max = 1000
            uniform double mjc:forceRange:min = -1000
            custom rel mjc:target
            append rel mjc:target = </robotiq_arg2f_140_model/Physics/finger_joint>
        }

        def MjcActuator "left_inner_knuckle_joint_actuator"
        {
            uniform double mjc:forceRange:max = 1000
            uniform double mjc:forceRange:min = -1000
            custom rel mjc:target
            append rel mjc:target = </robotiq_arg2f_140_model/Physics/left_inner_knuckle_joint>
        }

        def MjcActuator "left_inner_finger_joint_actuator"
        {
            uniform double mjc:forceRange:max = 1000
            uniform double mjc:forceRange:min = -1000
            custom rel mjc:target
            append rel mjc:target = </robotiq_arg2f_140_model/Physics/left_inner_finger_joint>
        }

        def MjcActuator "right_outer_knuckle_joint_actuator"
        {
            uniform double mjc:forceRange:max = 1000
            uniform double mjc:forceRange:min = -1000
            custom rel mjc:target
            append rel mjc:target = </robotiq_arg2f_140_model/Physics/right_outer_knuckle_joint>
        }

        def MjcActuator "right_inner_knuckle_joint_actuator"
        {
            uniform double mjc:forceRange:max = 1000
            uniform double mjc:forceRange:min = -1000
            custom rel mjc:target
            append rel mjc:target = </robotiq_arg2f_140_model/Physics/right_inner_knuckle_joint>
        }

        def MjcActuator "right_inner_finger_joint_actuator"
        {
            uniform double mjc:forceRange:max = 1000
            uniform double mjc:forceRange:min = -1000
            custom rel mjc:target
            append rel mjc:target = </robotiq_arg2f_140_model/Physics/right_inner_finger_joint>
        }
    }
}

